# Server binding (keep 127.0.0.1 when running behind Cloudflare Tunnel or Nginx/Caddy)
HOST=127.0.0.1
PORT=8080

# Canonical public URL used for SEO tags, sitemap.xml, robots.txt, and JSON-LD
SITE_URL=https://neddyap.tech

# Persistent directory for SQLite database (portfolio.db) and uploaded media
DATA_DIR=./data

# Admin credentials (generate hash with: ./bin/portfolio -hash-password)
ADMIN_EMAIL=neddy.prasetio@gmail.com
ADMIN_PASSWORD_HASH=

# Long random string (>= 32 chars) used to sign session & CSRF cookies:
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Set true when behind Cloudflare Tunnel / reverse proxy
TRUST_PROXY=true

# Maximum upload size in MB
MAX_UPLOAD_MB=5
